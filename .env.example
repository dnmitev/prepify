# Application
APP_ENV=development
NODE_ENV=development

# Postgres (local docker-compose default)
DATABASE_URL=postgresql://prepify:prepify@localhost:5432/prepify

# API (Next.js browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Allowed browser origins for CORS (comma-separated). Use * only in trusted dev setups.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Temporal (docker-compose default)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=prepify-main

# LLM — optional; mock providers need no keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Role routing (examples — adjust models without code changes)
# For real OpenAI generation JSON: set QUESTION_GENERATION to openai and supply OPENAI_API_KEY.
LLM_ROLE_SUMMARIZATION_PROVIDER=mock
LLM_ROLE_SUMMARIZATION_MODEL=gpt-4o-mini
LLM_ROLE_QUESTION_GENERATION_PROVIDER=mock
LLM_ROLE_QUESTION_GENERATION_MODEL=gpt-4o
