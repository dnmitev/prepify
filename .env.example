# Application
APP_ENV=development
NODE_ENV=development

# Postgres (application DB — docker-compose service `postgres`, port 5432)
DATABASE_URL=postgresql://prepify:prepify@localhost:5432/prepify

# API (Next.js browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Allowed browser origins for CORS (comma-separated). Use * only in trusted dev setups.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Temporal — matches docker-compose `temporal` service (gRPC on host 7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=prepify-main

# Cap generation batch size (POST /jobs/generate questionCount). Default 50 if unset or invalid.
# GENERATION_MAX_QUESTIONS_PER_JOB=50

# AI-generated question dedupe. Candidates at or above hard threshold are skipped;
# candidates at or above review threshold are accepted but useful for later tuning.
# More duplicate skips can require more candidate attempts to fill the requested count.
# QUESTION_DUPLICATE_HARD_THRESHOLD=0.94
# QUESTION_DUPLICATE_REVIEW_THRESHOLD=0.88
# QUESTION_GENERATION_MAX_ATTEMPT_MULTIPLIER=3

# Temporal Web UI (compose exposes 8080): http://localhost:8080

# --- Local LLM (Ollama + Gemma 4) — default for this repo’s local dev ---
# Recommended: host `ollama serve` + `ollama pull gemma4` (avoids Docker registry timeouts on some Mac/VPN setups).
# Optional Docker Ollama: `docker compose --profile ollama up -d` then
#   docker compose exec ollama ollama pull gemma4
# Never run host Ollama and compose Ollama both on port 11434.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1

# Role routing — generation hits Ollama’s OpenAI-compatible API (JSON optional per model quality)
LLM_ROLE_SUMMARIZATION_PROVIDER=mock
LLM_ROLE_SUMMARIZATION_MODEL=gpt-4o-mini
LLM_ROLE_QUESTION_GENERATION_PROVIDER=openai
# Match a tag you installed: gemma4:latest, gemma4:e4b, gemma4:e2b, etc.
LLM_ROLE_QUESTION_GENERATION_MODEL=gemma4:latest

# If generation targets a non-loopback URL without auth: LOCAL_LLM_SKIP_API_KEY=1

# --- Post-exam AI study guide (English-only; Temporal workflow after failed scored items) ---
# POST_EXAM_TRAINING_ENABLED=1
# Uses workflow id post-exam-training-<attemptId>. Requires worker + Temporal + pgvector (see docker-compose).
# LLM_ROLE_FAILURE_SUMMARIZATION_PROVIDER=mock
# LLM_ROLE_FAILURE_SUMMARIZATION_MODEL=mock-mini
# LLM_ROLE_POST_EXAM_TEACHING_PROVIDER=mock
# LLM_ROLE_POST_EXAM_TEACHING_MODEL=mock-large
# LLM_ROLE_EMBEDDING_PROVIDER=mock
# LLM_ROLE_EMBEDDING_MODEL=bge-small-en-v1.5
# Embeddings default to OPENAI_BASE_URL; override with a dedicated OpenAI-compatible embeddings base:
# EMBEDDING_OPENAI_BASE_URL=http://localhost:8089/v1
# Remote: use a cheap hosted embeddings API (dimensions must match migration: 384 for BGE small).

# --- Fallback when Ollama is not running (e.g. CI or DB-only work) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_ROLE_QUESTION_GENERATION_PROVIDER=mock
# LLM_ROLE_QUESTION_GENERATION_MODEL=gpt-4o
